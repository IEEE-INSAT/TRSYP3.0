# Copy this file to .env. Next.js, NestJS, Prisma, and Docker Compose all read
# the same root file. Render injects these values from its dashboard instead.

# Application
NODE_ENV=development
PORT=3001
BACKEND_PORT=3001
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase server authentication. Never expose the service role key publicly.
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Required only while the project uses legacy HS256 JWT signing.
SUPABASE_JWT_SECRET=

RIDDLE_CODE_SECRET=replace-with-a-long-random-secret

# Base URL of the NestJS backend (no trailing slash).
NEXT_PUBLIC_API_URL=http://localhost:3001

# Supabase client authentication.
# The matching Supabase project's Authentication > URL Configuration must
# include these Redirect URLs for local auth:
#   http://localhost:3000/auth/callback/
#   http://localhost:3000/verify-email/
#   http://localhost:3000/reset-password/
# A wildcard `http://localhost:3000/**` also covers all three.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# API-backed features.
NEXT_PUBLIC_FEATURE_REGISTRATION_API=true
NEXT_PUBLIC_FEATURE_ADMIN_API=false

# Participant registration window: true | false.
# Closes the "Participant" CTA and /register + /register/participant.
# The challenger entry point (/register/challenger) is unaffected.
NEXT_PUBLIC_PARTICIPANT_REGISTRATION_OPEN=true

# Team registration windows: soon | open | closed.
# Keep these aligned with the corresponding backend variables.
NEXT_PUBLIC_COMPETITION_PHASE=closed
NEXT_PUBLIC_CHALLENGE_PHASE=closed

# Adwya × Orange Fablab Challenge (Track 03). Team registration and the
# concept submission (a Drive link the leader submits from the dashboard) have
# separate windows: soon | open | closed. Each mirrors a backend variable below.
# Leave the spec book URL empty to show "coming soon".
NEXT_PUBLIC_FABLAB_PHASE=open
NEXT_PUBLIC_FABLAB_SUBMISSION_PHASE=open
NEXT_PUBLIC_FABLAB_SPEC_URL=

# Backend equivalents; keep both pairs aligned.
COMPETITION_REGISTRATION_PHASE=closed
CHALLENGE_REGISTRATION_PHASE=closed
FABLAB_REGISTRATION_PHASE=open
FABLAB_SUBMISSION_PHASE=open

# Payment proof submission: true | false. Backend-only and read per request,
# so flipping it needs no rebuild. The payment page always shows the fee
# table; this opens the proof form underneath it, and refuses the POST when
# closed. The UI asks the server via GET /payment/proof/me.
PAYMENT_PROOF_OPEN=false

# IEEE GetMemberStatus API (same credentials as the admin portal). Backend-only:
# never expose these to the browser. Without them no membership checks run and
# new participants stay priced as non-members.
IEEE_API_BASE_URL=https://services13.ieee.org/RST
IEEE_CLIENT_ID=
IEEE_CLIENT_SECRET=
