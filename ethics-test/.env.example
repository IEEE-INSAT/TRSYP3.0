MODERATOR_KEY=Organisation

# Global Config store holding the current step (no database).
# GLOBAL_CONFIG is added automatically when you connect the store to the
# project in Vercel (Storage tab). The other two let /control write to it.
GLOBAL_CONFIG=
GLOBAL_CONFIG_ID=
VERCEL_API_TOKEN=
# Only if the store belongs to a Vercel team, not a personal (Hobby) account.
VERCEL_TEAM_ID=
