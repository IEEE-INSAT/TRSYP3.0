# ============================================================================
# TRSYP 3.0 Backend - Environment Variables
# ============================================================================

# App
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
# Additional browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=https://rtc.ieee.tn,https://trsyp.ieee.tn

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase Auth
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Auth email delivery is configured in the Supabase Dashboard, not on Render.
# See docs/supabase-gmail-smtp.md for the Gmail SMTP settings.


RIDDLE_CODE_SECRET=your-riddle-code-secret
# ============================================================================
# Team registration windows: soon | open | closed
# `soon` and `closed` both reject create/join; managing an existing team is
# always allowed. Keep these in sync with the frontend's lib/config.ts.
# ============================================================================
COMPETITION_REGISTRATION_PHASE=open
CHALLENGE_REGISTRATION_PHASE=soon
