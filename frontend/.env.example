# Base URL of the NestJS backend (no trailing slash).
NEXT_PUBLIC_API_URL=http://localhost:3001

# Supabase client authentication.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# API-backed features.
NEXT_PUBLIC_FEATURE_REGISTRATION_API=true
NEXT_PUBLIC_FEATURE_ADMIN_API=false

# Team registration windows: soon | open | closed.
# Keep these aligned with the corresponding backend variables.
NEXT_PUBLIC_COMPETITION_PHASE=open
NEXT_PUBLIC_CHALLENGE_PHASE=soon
